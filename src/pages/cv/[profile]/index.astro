---
import CVDocument from '../../../components/CVDocument.astro';
import CVLayout from '../../../layouts/CVLayout.astro';
import { cvProfiles } from '../../../data';

export function getStaticPaths() {
  return cvProfiles.map((cvProfile) => ({ params: { profile: cvProfile.id }, props: { cvProfile } }));
}
const { cvProfile } = Astro.props;
---
<CVLayout title={`CV ${cvProfile.label} — Putra Kamulyan`}>
  <div class="no-print cv-bar">
    <a href="/">← Portfolio</a>
    <div class="cv-bar-actions">
      <a href={`/cv/${cvProfile.fileName}`} download>Unduh PDF</a>
      <button class="button" type="button" onclick="window.print()">Cetak</button>
    </div>
  </div>
  <div class="no-print cv-switch" role="group" aria-label="Pilih versi CV">
    <span class="cv-switch-label">Versi CV</span>
    {cvProfiles.map((item) => (
      <a
        class:list={['cv-switch-item', item.id === cvProfile.id && 'is-active']}
        href={`/cv/${item.id}/`}
        aria-current={item.id === cvProfile.id ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </div>
  <CVDocument cvProfile={cvProfile} />
</CVLayout>
