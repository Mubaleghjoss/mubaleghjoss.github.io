---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LearningBadge from '../../components/LearningBadge.astro';
import { learningProjects, otherProjects, projects } from '../../data';
---
<BaseLayout title="Project — Putra Kamulyan" description="Portfolio project produksi dan learning project Putra Kamulyan." path="/projects/">
  <section class="project-hero"><div class="container"><p class="eyebrow">Portfolio</p><h1>Project yang dibangun dari kebutuhan nyata.</h1><p class="lead">Case study produksi dipisahkan dari learning project agar klaim pengalaman tetap akurat dan mudah diperiksa.</p></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Case study produksi</p><h2>Project utama</h2></div><div class="grid grid--2">{projects.map((project) => <a class="card card-link" href={`/projects/${project.slug}/`}><p class="card-kicker">{project.positioning} · {project.period}</p><h3>{project.name}</h3><p>{project.summary}</p><div class="tag-list">{project.tech.flatMap((section) => section.items).slice(0, 7).map((item) => <span class="tag">{item}</span>)}</div><span class="arrow">Baca case study →</span></a>)}</div></div></section>
  <section class="section section--surface"><div class="container"><div class="section-head"><p class="eyebrow">Learning project</p><h2>Repo sederhana, dikerjakan dan diuji.</h2><p>Tujuannya belajar secara eksplisit. Tidak diposisikan sebagai pengalaman penggunaan produksi.</p></div><div class="grid grid--3">{learningProjects.map((project) => <article class="card"><LearningBadge status={project.status} /><h3 style="margin-top: .85rem">{project.name}</h3><p class="card-kicker">{project.positioning}</p><p>{project.summary}</p><div class="tag-list">{project.covers.slice(0, 5).map((item) => <span class="tag">{item}</span>)}</div>{project.repo && <p style="margin-top: 1rem"><a href={project.repo} rel="noreferrer" target="_blank">Buka repository →</a></p>}<p style="font-size: .84rem; margin-top: .7rem">{project.note}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Project lain</p><h2>Aplikasi pendukung dan kontribusi.</h2></div><div class="grid grid--3">{otherProjects.map((project) => <article class="card"><p class="card-kicker">{project.positioning}</p><h3>{project.name}</h3><p>{project.summary}</p><div class="tag-list">{project.tech.map((item) => <span class="tag">{item}</span>)}</div><p style="margin-top: 1rem">{project.url && <a href={project.url} target="_blank" rel="noreferrer">Website</a>}{project.url && project.repo && ' · '}{project.repo && <a href={project.repo} target="_blank" rel="noreferrer">Repository</a>}</p></article>)}</div></div></section>
</BaseLayout>
